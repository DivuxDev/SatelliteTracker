# Token de Cesium Ion (OPCIONAL).
# Sin token la app usa la textura Natural Earth II que viene empaquetada con
# CesiumJS: funciona 100% offline y sin cuenta. Con token se activa la imagineria
# mundial de alta resolucion de Cesium Ion.
VITE_CESIUM_ION_TOKEN=

# Base para las peticiones TLE. Por defecto usa el proxy de Vite (/celestrak).
# En produccion apunta a tu propio proxy inverso hacia https://celestrak.org
VITE_CELESTRAK_BASE=/celestrak

# Token de Mapillary (OPCIONAL).
# Habilita el panel "Mi horizonte a pie de calle" del simulador de pasadas, que
# muestra la imagen de calle mas cercana al observador. Es gratuito y no exige
# cuenta de facturacion: se saca en mapillary.com/dashboard/developers creando
# una aplicacion y copiando su Client Token (empieza por MLY|).
# Sin token el panel explica que falta y el resto de la app funciona igual.
VITE_MAPILLARY_TOKEN=
